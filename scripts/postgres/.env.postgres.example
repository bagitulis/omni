# =============================================================================
# PostgreSQL Configuration for Multi-Tenant Migration
# =============================================================================
# Copy this file to .env.postgres and update with your values
# =============================================================================

# PostgreSQL Server
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=omni
POSTGRES_PASSWORD=omni_secure_2026
POSTGRES_DB=omni_main

# PgBouncer (Connection Pooling)
PGBOUNCER_HOST=localhost
PGBOUNCER_PORT=6432

# pgAdmin (Optional)
PGADMIN_EMAIL=admin@omni.local
PGADMIN_PASSWORD=admin123

# Backend Go Configuration
DB_DRIVER=postgres
# Use PgBouncer in production:
# DATABASE_URL=postgres://omni:omni_secure_2026@pgbouncer:6432/omni_main?sslmode=disable
DATABASE_URL=postgres://omni:omni_secure_2026@localhost:5432/omni_main?sslmode=disable

# Connection Pool Settings
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=1h

# Migration Settings
MIGRATION_BATCH_SIZE=1000
MIGRATION_CONTINUE_ON_ERROR=false
