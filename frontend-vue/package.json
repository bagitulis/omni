{
  "name": "ecommerce-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "vite build && node analyze-bundle.mjs && echo '\n✅ Bundle analysis generated at dist/bundle-analysis.html'",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "analyze": "node analyze-bundle.mjs",
    "convert-images": "tsx scripts/imageConverter.ts",
    "convert-svg": "tsx scripts/svgToWebp.ts",
    "convert-all": "npm run convert-svg && npm run convert-images",
    "lighthouse": "lighthouse http://localhost:5173 --only-categories=performance --output=html --output-path=./lighthouse-report.html --chrome-flags=\"--headless\"",
    "lighthouse:prod": "npm run build && npx serve -s dist -l 4173 & sleep 3 && lighthouse http://localhost:4173 --only-categories=performance --output=html --output-path=./lighthouse-report.html --chrome-flags=\"--headless\""
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "@tanstack/vue-query": "^5.92.9",
    "@tanstack/vue-virtual": "^3.13.18",
    "@vueuse/core": "^14.1.0",
    "apexcharts": "^5.3.6",
    "axios": "1.13.2",
    "pinia": "3.0.4",
    "vue": "3.5.26",
    "vue-router": "4.6.4",
    "vue3-apexcharts": "^1.10.0",
    "web-vitals": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.1",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/postcss": "4.1.18",
    "@tailwindcss/typography": "0.5.19",
    "@types/node": "^25.0.3",
    "@typescript-eslint/eslint-plugin": "8.50.0",
    "@typescript-eslint/parser": "8.50.0",
    "@vitejs/plugin-vue": "6.0.3",
    "autoprefixer": "10.4.23",
    "critters": "^0.0.23",
    "dependency-cruiser": "^17.3.6",
    "eslint": "9.39.2",
    "eslint-plugin-vue": "10.6.2",
    "globals": "^16.5.0",
    "knip": "^5.78.0",
    "postcss": "8.5.6",
    "rollup-plugin-visualizer": "6.0.5",
    "sharp": "0.34.5",
    "tailwindcss": "4.1.18",
    "terser": "5.44.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.0",
    "vite-plugin-compression": "0.5.1",
    "vue-eslint-parser": "10.2.0"
  }
}
