{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  "google_auth": false,
  "default_model": "google/gemini-3-pro",

  "agents": {
    "sisyphus": {
      "model": "google/claude-opus-4-5-thinking",
      "variant": "max",
      "prompt_append": "⚠️ READ FILE: RULES.md (mandatory rules table). Then SISYPHUS_RULES.md.",
      "skills": ["stuck-recovery"]
    },
    "prometheus": {
      "model": "google/claude-opus-4-5-thinking",
      "variant": "max",
      "prompt_append": "⚠️ READ FILE: RULES.md (mandatory rules table). Then PROMETHEUS_RULES.md."
    },
    "atlas": {
      "model": "google/claude-sonnet-4-5-thinking",
      "variant": "max"
    },
    "hephaestus": {
      "model": "google/claude-opus-4-5-thinking",
      "variant": "max",
      "prompt_append": "⚠️ READ FILE: RULES.md (mandatory rules table). Then EXECUTOR_RULES.md.",
      "skills": ["stuck-recovery"]
    },
    "oracle": {
      "model": "openai/gpt-5.2",
      "reasoningEffort": "high",
      "temperature": 0.1,
      "skills": ["oracle-rules"]
    },
    "librarian": {
      "model": "google/gemini-3-pro",
      "variant": "high",
      "skills": ["librarian-rules"]
    },
    "explore": {
      "model": "github-copilot/claude-haiku-4.5",
      "skills": ["explore-rules"]
    },
    "multimodal-looker": {
      "model": "openai/gpt-5.2",
      "reasoningEffort": "medium"
    },
    "metis": {
      "model": "google/gemini-3-pro",
      "variant": "high",
      "skills": ["metis-rules"]
    },
    "momus": {
      "model": "openai/gpt-5.2",
      "reasoningEffort": "high",
      "temperature": 0.1,
      "skills": ["momus-rules"]
    },
    "sisyphus-junior": {
      "model": "google/claude-sonnet-4-5-thinking",
      "variant": "max",
      "prompt_append": "⚠️ READ FILE: RULES.md (mandatory rules table). Then EXECUTOR_RULES.md.",
      "skills": ["stuck-recovery"]
    },
    "default": {
      "model": "google/gemini-3-pro",
      "variant": "high"
    }
  },

  "categories": {
    "visual-engineering": {
      "model": "google/gemini-3-pro",
      "variant": "high"
    },
    "artistry": {
      "model": "google/gemini-3-pro",
      "variant": "high"
    },
    "writing": {
      "model": "google/gemini-3-flash",
      "variant": "high"
    },
    "quick": {
      "model": "github-copilot/claude-haiku-4.5"
    },
    "ultrabrain": {
      "model": "openai/gpt-5.2-codex",
      "reasoningEffort": "high",
      "temperature": 0.1
    },
    "deep": {
      "model": "openai/gpt-5.2-codex",
      "reasoningEffort": "high",
      "temperature": 0.1
    },
    "implementation": {
      "model": "google/gemini-3-pro",
      "variant": "high"
    },
    "review": {
      "model": "google/gemini-3-pro",
      "variant": "high"
    },
    "testing": {
      "model": "google/gemini-3-pro",
      "variant": "high"
    },
    "security": {
      "model": "github-copilot/claude-opus-4.5"
    },
    "unspecified-low": {
      "model": "github-copilot/claude-haiku-4.5"
    },
    "unspecified-high": {
      "model": "github-copilot/claude-opus-4.5"
    }
  }
}
