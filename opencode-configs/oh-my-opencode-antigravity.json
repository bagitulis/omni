{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  "google_auth": false,
  "default_model": "google/gemini-3-pro",
  "variant": "high",
  "browser_automation_engine": {
    "provider": "agent-browser"
  },

  "agents": {
    "sisyphus": {
      "model": "google/claude-opus-4-5-thinking",
      "variant": "max",
      "prompt_append": "⚠️ READ FILE: AGENTS.md (mandatory rules table). Then SISYPHUS_RULES.md.",
      "skills": ["stuck-recovery"]
    },
    "prometheus": {
      "model": "google/claude-opus-4-5-thinking",
      "variant": "max",
      "prompt_append": "⚠️ READ FILE: AGENTS.md (mandatory rules table). Then PROMETHEUS_RULES.md."
    },
    "atlas": {
      "model": "google/claude-opus-4-5-thinking",
      "variant": "max",
      "prompt_append": "⚠️ READ FILE: AGENTS.md (mandatory rules table). Then EXECUTOR_RULES.md.\n\n🎯 REACT MIGRATION MODE: You are implementing the React migration plan. Load skill 'react-frontend-rules' for Design System specs. After UI implementation, load 'playwright-layout-eval' skill and verify layout matches specifications.",
      "skills": ["stuck-recovery", "react-frontend-rules"]
    },
    "hephaestus": {
      "model": "google/claude-opus-4-5-thinking",
      "variant": "max",
      "prompt_append": "⚠️ READ FILE: AGENTS.md (mandatory rules table). Then EXECUTOR_RULES.md.",
      "skills": ["stuck-recovery", "react-frontend-rules"]
    },
    "oracle": {
      "model": "google/gemini-3-pro",
      "variant": "high",
      "skills": ["oracle-rules"]
    },
    "librarian": {
      "model": "google/gemini-3-pro",
      "variant": "high",
      "skills": ["librarian-rules"]
    },
    "explore": {
      "model": "google/gemini-3-flash",
      "variant": "high",
      "skills": ["explore-rules"]
    },
    "multimodal-looker": {
      "model": "google/gemini-3-pro",
      "variant": "high"
    },
    "metis": {
      "model": "google/gemini-3-pro",
      "variant": "high",
      "skills": ["metis-rules"]
    },
    "momus": {
      "model": "google/gemini-3-pro",
      "variant": "high",
      "skills": ["momus-rules"]
    },
    "sisyphus-junior": {
      "model": "google/claude-sonnet-4-5-thinking",
      "variant": "max",
      "prompt_append": "⚠️ READ FILE: AGENTS.md (mandatory rules table). Then EXECUTOR_RULES.md.",
      "skills": ["stuck-recovery", "react-frontend-rules"]
    },
    "default": {
      "model": "google/claude-sonnet-4-5-thinking",
      "variant": "max"
    }
  },

  "categories": {
    "visual-engineering": {
      "model": "google/gemini-3-pro",
      "variant": "high",
      "skills": ["react-frontend-rules", "playwright-layout-eval"],
      "prompt_append": "SCREENSHOT RULE: ALWAYS save screenshots to 'docs/Screenshots/' directory with descriptive names (e.g., docs/Screenshots/page-desktop.png). NEVER save to root folder."
    },
    "artistry": {
      "model": "google/gemini-3-pro",
      "variant": "high"
    },
    "writing": {
      "model": "google/gemini-3-flash",
      "variant": "high"
    },
    "quick": {
      "model": "google/gemini-3-flash",
      "variant": "high"
    },
    "ultrabrain": {
      "model": "google/claude-opus-4-5-thinking",
      "variant": "max"
    },
    "deep": {
      "model": "google/gemini-3-pro",
      "variant": "high"
    },
    "implementation": {
      "model": "google/claude-sonnet-4-5-thinking",
      "variant": "max"
    },
    "review": {
      "model": "google/gemini-3-pro",
      "variant": "high"
    },
    "testing": {
      "model": "google/gemini-3-pro",
      "variant": "high"
    },
    "security": {
      "model": "google/claude-opus-4-5-thinking",
      "variant": "max"
    },
    "unspecified-low": {
      "model": "google/gemini-3-flash",
      "variant": "high"
    },
    "unspecified-high": {
      "model": "google/claude-opus-4-5-thinking",
      "variant": "max"
    }
  }
}
