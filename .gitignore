# ===========================================
# DEPENDENCIES ONLY - Data tetap di-track
# Repo sudah private
# ===========================================


# Node.js dependencies
node_modules/

# PostgreSQL data directory (Docker volume)
# JANGAN masuk git - ini binary data, bukan SQL
# Untuk pindah PC, gunakan backups/db-tools/menu.bat
data/postgres/


# Python dependencies & cache
.venv/
venv/
__pycache__/
*.pyc
*.pyo

# Ad-hoc cleanup / restore safety-net dirs (never commit — they hold
# gigabytes of pre-cleanup archives + build logs).
.backup-cleanup-*/

# Build artifacts (bisa di-rebuild)
backend/bin/
*.exe

# Frontend build output
frontend/dist/
frontend-vue/dist/

# TypeScript incremental build artifacts
*.tsbuildinfo

# CodeGraph index (local analysis cache, rebuilt with `codegraph init`)
# Contains ~100k nodes / ~220k edges of derived data — never commit it.
.codegraph/

# Vite compile artifacts (generated from .ts source)
frontend/vite.config.js
frontend/vite.config.d.ts

# Test coverage and analysis reports
frontend/coverage/
frontend/lighthouse-report.json

# Local artifacts - null/nul files (Windows device name artifacts)
**/nul
**/null

# Temporary files
*.log
*.tmp
*_copy*
allcode-*.txt


# Nginx logs (runtime generated, potential PII)
nginx/logs/

# IDE generated
.vscode/mcp.json

opencode.exe

# Source maps at root level (build artifacts)
/*.js.map

# ===========================================
# Database Backups
# ===========================================
# Legacy smart backup (sql.gz) — fully replaced by ndjson sync
# Not tracked in git (binary, large, not diffable)
backups/smart/

# NDJSON sync backup (primary, git-friendly)
# Large files (>=10K rows) use Git LFS via backups/sync/_large/
# Schema DDL stored in backups/sync/_schema/ (text, tracked)
# Everything in backups/sync/ IS tracked (portable cross-machine sync)

# ===========================================
# AI/Tool Generated (ephemeral, not source code)
# ===========================================
# Playwright MCP session recordings (auto-generated browser snapshots)
.playwright-mcp/

# Playwright test artifacts (per-run traces, screenshots, videos, reports)
frontend/test-results/
frontend/playwright-report/

# Sisyphus evidence (screenshots, test artifacts, ephemeral)
.sisyphus/evidence/
!.sisyphus/evidence/
.sisyphus/evidence/*
!.sisyphus/evidence/F1-compliance-audit-v2.txt
!.sisyphus/evidence/F4-scope-fidelity-v2.txt
!.sisyphus/evidence/SG-redaction-gate-v2.txt
!.sisyphus/evidence/task-b8-audit-report.md
!.sisyphus/evidence/task-b8-completeness.txt
!.sisyphus/evidence/task-b8-fail-fast.txt


# ===========================================
# Runtime / OS Generated
# ===========================================
# Docker runtime
docker-compose.override.yml

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Credentials (NEVER commit)
*.env
.sisyphus/plans/*.env
.omo/plans/*.env
.omo/evidence/

# NOTE: .env (root) is currently tracked by git.
# To untrack: git rm --cached .env (run manually, AI agents cannot execute git rm)
