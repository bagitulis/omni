# ============================================
# OMNI - Environment Variables Template
# ============================================
# Copy this file to .env and fill in the values.
# Variables marked __SET_IN_GH_SECRETS__ are injected
# by CI/CD and should NOT be stored in this file.
# ============================================

# ============================================
# 1. APPLICATION
# ============================================
GO_ENV=production
APP_ENV=production
PORT=3000
TZ=Asia/Jakarta
FRONTEND_SOURCE_PATH=/app/frontend/src
CONFIG_PATH=/app/config

# ============================================
# 2. SECURITY - CRITICAL!
# ============================================
# Generate strong keys: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
JWT_REFRESH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
ENCRYPTION_KEY=CHANGE_ME_must_be_exactly_32_characters
DEV_USER_PASSWORD=CHANGE_ME_set_strong_dev_password
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL=168h
LEGACY_CRYPTO_FALLBACK=false
ALLOWED_HOSTS=${DOMAIN_NAME},www.${DOMAIN_NAME}

# ============================================
# 3. DATABASE (PostgreSQL)
# ============================================
DB_DRIVER=postgres
PG_HOST=postgres
PG_PORT=5432
PG_USER=omni
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_24
PG_DATABASE=omni_main
PG_SSLMODE=disable
DATABASE_PATH=/app/config/databases

# ============================================
# 4. REDIS
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_24

# ============================================
# 5. DOMAIN / CORS
# ============================================
DOMAIN_NAME=example.com
DOMAIN_WWW=true
SSL_MODE=cloudflare
FRONTEND_URL=https://${DOMAIN_NAME}
CORS_ORIGINS=https://${DOMAIN_NAME},https://www.${DOMAIN_NAME}

# ============================================
# 6. DEPLOY TARGET
# ============================================
DEPLOY_TARGET=vps
DEPLOY_PROFILE=production
DEPLOY_SPEC=highspec
VPS_HOST=__SET_IN_GH_SECRETS__
VPS_PORT=22
VPS_USER=root
VPS_DEPLOY_PATH=/opt/omni
VPS_SSH_KEY=__SET_IN_GH_SECRETS__

# ============================================
# 7. CLOUDFLARE TUNNEL
# ============================================
CLOUDFLARE_TUNNEL_TOKEN=__SET_IN_GH_SECRETS__

# ============================================
# 8. RATE LIMITING
# ============================================
RATE_LIMITING_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=1m
AUTH_RATE_LIMIT=30
LOGIN_RATE_LIMIT=10
API_RATE_LIMIT=1000
SYNC_RATE_LIMIT=5000
WEBHOOK_RATE_LIMIT=1000

# ============================================
# 9. ACCOUNT LOCKOUT
# ============================================
MAX_LOGIN_ATTEMPTS=10
LOCKOUT_DURATION=15m

# ============================================
# 10. MARKETPLACE APIs
# ============================================
# --- Shopee ---
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_PUSH_PARTNER_KEY=
SHOPEE_REDIRECT_URL=

# --- Lazada ---
LAZADA_APP_KEY=
LAZADA_APP_SECRET=
LAZADA_REDIRECT_URL=

# --- TikTok Shop ---
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_REDIRECT_URL=

# ============================================
# 11. EMAIL (SMTP)
# ============================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ============================================
# 12. LOGGING
# ============================================
LOG_LEVEL=info

# ============================================
# 13. TESTING (Lighthouse E2E)
# ============================================
LIGHTHOUSE_USERNAME=
LIGHTHOUSE_PASSWORD=

# ============================================
# 14. MONITORING / ALERTING
# ============================================
ALERT_ENABLED=true
ALERT_TELEGRAM_BOT_TOKEN=__SET_IN_GH_SECRETS__
ALERT_TELEGRAM_CHAT_ID=__SET_IN_GH_SECRETS__
DISK_USAGE_THRESHOLD=80

# ============================================
# 15. BACKUP
# ============================================
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=7
BACKUP_PATH=/opt/omni/backups
UPLOAD_PATH=./data

# ============================================
# 16. GITHUB SECRETS (CI/CD)
# ============================================
# The following secrets MUST be configured in your GitHub repository
# under Settings > Secrets and variables > Actions.
# They are injected at deploy time and MUST NOT be stored in this file.
#
# --- VPS Access ---
# VPS_HOST          = <YOUR_VPS_IP>            (your server's public IP)
# VPS_USER          = <YOUR_SSH_USER>          (e.g. root)
# VPS_SSH_KEY       = <YOUR_SSH_KEY_PATH>      (contents of ~/.ssh/id_ed25519)
#                     IMPORTANT: Include the full key with
#                     REDACTED:PRIVATE_KEY_REMOVED markers.
# VPS_DEPLOY_PATH   = <YOUR_DEPLOY_PATH>       (e.g. /opt/omni)
#
# --- Alerting (required if ALERT_ENABLED=true) ---
# TELEGRAM_BOT_TOKEN = <YOUR_TELEGRAM_BOT_TOKEN> (from @BotFather)
# TELEGRAM_CHAT_ID   = <YOUR_TELEGRAM_CHAT_ID>   (from @userinfobot)
#
# To add all secrets at once via GitHub CLI:
#   gh secret set VPS_HOST --body '<YOUR_VPS_IP>'
#   gh secret set VPS_USER --body '<YOUR_SSH_USER>'
#   gh secret set VPS_SSH_KEY < <YOUR_SSH_KEY_PATH>
#   gh secret set VPS_DEPLOY_PATH --body '<YOUR_DEPLOY_PATH>'
#   gh secret set TELEGRAM_BOT_TOKEN --body '<YOUR_TELEGRAM_BOT_TOKEN>'
#   gh secret set TELEGRAM_CHAT_ID --body '<YOUR_TELEGRAM_CHAT_ID>'
