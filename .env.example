# ============================================
# Environment Variables Template
# Copy this file to .env and fill in the values
# ============================================

# Application
NODE_ENV=production
PORT=3000

# Security - CRITICAL: Generate strong keys!
ENCRYPTION_KEY=your-32-character-encryption-key-here
JWT_SECRET=your-jwt-secret-key-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-here
REDIS_PASSWORD=your-redis-password-here

# Cloudflare Tunnel (untuk hosting dari PC rumah)
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here

# Database
DATABASE_PATH=/app/config/databases

# Shopee API
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URL=

# Lazada API
LAZADA_APP_KEY=
LAZADA_APP_SECRET=
LAZADA_REDIRECT_URL=

# TikTok Shop API
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_REDIRECT_URL=

# Email (Optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Logging
LOG_LEVEL=info
