# ============================================
# Environment Variables Template
# Copy this file to .env and fill in the values
# ============================================

# Application
APP_ENV=production          # production | development | staging
PORT=3000

# ============================================
# SECURITY SETTINGS - CRITICAL!
# ============================================
# Generate strong keys: openssl rand -base64 48

# JWT_SECRET: REQUIRED in production (min 32 chars)
# - Used for access token signing
# - Generate with: openssl rand -base64 48
JWT_SECRET=your-jwt-secret-key-minimum-32-characters-here

# JWT_REFRESH_SECRET: Used for refresh token signing
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-here

# ENCRYPTION_KEY: For data encryption (must be 32 chars)
ENCRYPTION_KEY=your-32-character-encryption-key-here

# Redis password (if using Redis)
REDIS_PASSWORD=your-redis-password-here

# ============================================
# TOKEN SETTINGS (defaults shown)
# ============================================
# ACCESS_TOKEN_TTL=30m       # Access token lifetime (30 minutes)
# REFRESH_TOKEN_TTL=168h     # Refresh token lifetime (7 days)

# ============================================
# RATE LIMITING (defaults shown)
# ============================================
# AUTH_RATE_LIMIT=30         # Auth requests per minute per IP
# LOGIN_RATE_LIMIT=10        # Login attempts per minute per IP
# API_RATE_LIMIT=1000        # General API requests per minute
# SYNC_RATE_LIMIT=5000       # Sync operations per minute per tenant
# WEBHOOK_RATE_LIMIT=1000    # Incoming webhooks per minute

# ============================================
# ACCOUNT LOCKOUT (defaults shown)
# ============================================
# MAX_LOGIN_ATTEMPTS=10      # Failed attempts before lockout
# LOCKOUT_DURATION=15m       # Lockout duration

# Cloudflare Tunnel (untuk hosting dari PC rumah)
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here

# Database
DATABASE_PATH=/app/config/databases

# Shopee API
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URL=

# Lazada API
LAZADA_APP_KEY=
LAZADA_APP_SECRET=
LAZADA_REDIRECT_URL=

# TikTok Shop API
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_REDIRECT_URL=

# Email (Optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Logging
LOG_LEVEL=info


# Testing (Lighthouse E2E)
LIGHTHOUSE_USERNAME=
LIGHTHOUSE_PASSWORD=