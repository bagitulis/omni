# Never copy the host node_modules into the container. On Windows +
# Podman it clobbers the container-side `npm ci` output and strips the
# executable bit from bin scripts (`tsc: Permission denied`, WinError-2
# equivalents inside the build). The Dockerfile installs deps with
# `npm ci` inside the builder stage.
node_modules
npm-debug.log
yarn-debug.log
yarn-error.log

# Build artifacts (regenerated by the Dockerfile)
dist
build
.vite

# Local env / editor cruft
.env
.env.local
.env.*.local
.vscode
.idea
*.swp
.DS_Store
Thumbs.db

# Test artifacts
coverage
.nyc_output

# Version-control metadata
.git
.gitignore
