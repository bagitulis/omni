// ============================================
// Shopee Ads - Product Data (Raw from CSV)
// ============================================
model ShopeeAdsProductData {
  id                      Int      @id @default(autoincrement())
  tenantId                String
  uploadBatchId           String?

  // Period info (extracted from filename - weekly)
  periodStart             DateTime
  periodEnd               DateTime
  periodLabel             String?  // e.g., "2026-W02"

  // Product info
  productId               String   // Kode Produk
  productName             String   // Nama Iklan
  status                  String?  // Status (Berjalan, etc)
  
  // Ad configuration
  biddingMode             String?  // Mode Bidding (GMV Max ROAS, etc)
  placement               String?  // Penempatan Iklan
  startDate               DateTime? // Tanggal Mulai campaign
  endDate                 String?  // Tanggal Selesai (Tidak Terbatas)

  // Engagement metrics
  impressions             Int      @default(0)  // Dilihat
  clicks                  Int      @default(0)  // Jumlah Klik
  ctr                     Float    @default(0)  // Persentase Klik
  
  // Conversion metrics
  conversions             Int      @default(0)  // Konversi
  directConversions       Int      @default(0)  // Konversi Langsung
  conversionRate          Float    @default(0)  // Tingkat konversi
  directConversionRate    Float    @default(0)  // Tingkat Konversi Langsung
  costPerConversion       Float    @default(0)  // Biaya per Konversi
  costPerDirectConversion Float    @default(0)  // Biaya per Konversi Langsung
  
  // Sales metrics
  unitsSold               Int      @default(0)  // Produk Terjual
  directUnitsSold         Int      @default(0)  // Terjual Langsung
  
  // Financial metrics
  revenue                 Float    @default(0)  // Omzet Penjualan
  directRevenue           Float    @default(0)  // Penjualan Langsung (GMV Langsung)
  cost                    Float    @default(0)  // Biaya
  roas                    Float    @default(0)  // Efektifitas Iklan (ROAS)
  directRoas              Float    @default(0)  // Efektivitas Langsung
  acos                    Float    @default(0)  // ACOS
  directAcos              Float    @default(0)  // ACOS Langsung

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // Relations
  uploadBatch             ShopeeAdsUploadBatch? @relation(fields: [uploadBatchId], references: [id], onDelete: SetNull)

  // Unique constraint for deduplication
  @@unique([tenantId, productId, periodStart, periodEnd], name: "idx_shopeeads_unique_product")
  @@index([tenantId])
  @@index([productId])
  @@index([biddingMode])
  @@index([periodStart, periodEnd])
  @@index([uploadBatchId])
}
