// ============================================
// TikTok Ads - Upload Batch Tracking
// ============================================
model TiktokAdsUploadBatch {
  id              String   @id @default(cuid())
  tenantId        String
  fileName        String
  periodStart     DateTime
  periodEnd       DateTime
  totalRows       Int      @default(0)
  insertedRows    Int      @default(0)
  skippedRows     Int      @default(0)
  updatedRows     Int      @default(0)
  status          String   @default("pending") // pending, processing, completed, failed
  errorMessage    String?
  uploadedBy      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  creativeData    TiktokAdsCreativeData[]

  @@index([tenantId])
  @@index([status])
  @@index([periodStart, periodEnd])
}

// ============================================
// TikTok Ads - Creative Data (Raw from Excel)
// ============================================
model TiktokAdsCreativeData {
  id                      Int      @id @default(autoincrement())
  tenantId                String
  uploadBatchId           String?

  // Period info (extracted from filename)
  periodStart             DateTime
  periodEnd               DateTime

  // Campaign info
  campaignId              String   // ID Campaign
  campaignName            String   // Nama kampanye
  
  // Product info
  productId               String   // ID produk
  
  // Creative info
  creativeType            String   // Jenis materi iklan (Video/Kartu produk)
  videoTitle              String?  // Judul video
  videoId                 String?  // ID video
  tiktokAccount           String?  // Akun TikTok
  postingTime             DateTime? // Waktu posting
  status                  String?  // Status (Ditayangkan, etc)
  authorizationType       String?  // Jenis otorisasi

  // Financial metrics
  cost                    Float    @default(0)  // Biaya
  ordersSku               Int      @default(0)  // Pesanan SKU
  costPerOrder            Float    @default(0)  // Biaya per pesanan
  grossRevenue            Float    @default(0)  // Pendapatan kotor
  roi                     Float    @default(0)  // ROI

  // Engagement metrics
  impressions             Int      @default(0)  // Impresi iklan produk
  clicks                  Int      @default(0)  // Jumlah klik iklan produk
  ctr                     Float    @default(0)  // Tingkat klik iklan produk
  conversionRate          Float    @default(0)  // Rasio konversi iklan

  // Video watch metrics (stored as decimal 0-1)
  watchRate2s             Float?   // Rasio tayang video iklan 2 detik
  watchRate6s             Float?   // Rasio tayang video iklan 6 detik
  watchRate25pct          Float?   // Rasio tayang video iklan 25%
  watchRate50pct          Float?   // Rasio tayang video iklan 50%
  watchRate75pct          Float?   // Rasio tayang video iklan 75%
  watchRate100pct         Float?   // Rasio tayang video iklan 100%

  currency                String   @default("IDR")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // Relations
  uploadBatch             TiktokAdsUploadBatch? @relation(fields: [uploadBatchId], references: [id], onDelete: SetNull)

  // Unique constraint for deduplication
  @@unique([tenantId, campaignId, productId, videoId, periodStart, periodEnd], name: "idx_tiktokads_unique_creative")
  @@index([tenantId])
  @@index([campaignId])
  @@index([productId])
  @@index([creativeType])
  @@index([periodStart, periodEnd])
  @@index([uploadBatchId])
}

// ============================================
// TikTok Ads - Product Summary (Aggregated)
// ============================================
model TiktokAdsProductSummary {
  id                  String   @id @default(cuid())
  tenantId            String
  productId           String
  
  // Period
  periodType          String   // daily, weekly, monthly
  periodDate          DateTime // Start of period
  
  // Aggregated metrics
  totalCost           Float    @default(0)
  totalOrders         Int      @default(0)
  totalRevenue        Float    @default(0)
  avgRoi              Float    @default(0)
  avgCtr              Float    @default(0)
  avgConversionRate   Float    @default(0)
  totalImpressions    Int      @default(0)
  totalClicks         Int      @default(0)
  
  // Best performers
  bestCreativeType    String?  // Video or Kartu produk
  topVideoId          String?
  topVideoTitle       String?
  
  // Trend indicators
  roiTrend            String?  // up, down, stable
  costTrend           String?
  ordersTrend         String?
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([tenantId, productId, periodType, periodDate])
  @@index([tenantId])
  @@index([productId])
  @@index([periodType, periodDate])
}

// ============================================
// TikTok Ads - ML Predictions
// ============================================
model TiktokAdsMLPrediction {
  id                      String   @id @default(cuid())
  tenantId                String
  productId               String
  
  // Prediction period
  predictionDate          DateTime // When prediction was made
  targetMonth             Int      // Target month for prediction
  targetYear              Int      // Target year for prediction
  
  // ROI Prediction
  predictedRoi            Float?
  roiConfidence           Float?   // 0-1 confidence score
  
  // Budget Recommendation
  recommendedBudget       Float?
  budgetReason            String?
  
  // Performance Score (A/B/C/D/F)
  performanceScore        String?
  performanceReason       String?
  
  // Creative Score
  creativeScore           Float?   // 0-100
  bestCreativeType        String?
  
  // Insights (JSON array of insights)
  insights                String?  // JSON: ["insight1", "insight2", ...]
  
  // Anomaly Detection
  hasAnomaly              Boolean  @default(false)
  anomalyType             String?
  anomalyDescription      String?
  
  // Model metadata
  modelVersion            String   @default("v1.0")
  modelType               String?  // xgboost, lightgbm, random_forest
  trainingDataPoints      Int?
  
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([tenantId, productId, targetMonth, targetYear])
  @@index([tenantId])
  @@index([productId])
  @@index([targetMonth, targetYear])
  @@index([performanceScore])
}

