# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# CORS Configuration - Allow frontend to connect
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5000

# ============================================================
# ⚠️ MULTI-TENANT DATABASE ARCHITECTURE ⚠️
# ============================================================
# This project uses SEPARATE databases per tenant!
# DO NOT use a single dev.db - each tenant has their own database.
#
# Database location: backend/config/databases/
#   - {tenant}_bertigamart.db (main tenant data)
#   - {tenant}_jobs.db (jobs & auto-functions)
#
# Tenant config: backend/config/static/tenants.json
# Runtime selection: src/services/tenantManagementService.ts
#
# DATABASE_URL below is ONLY for Prisma CLI (migrate/generate).
# At runtime, the app dynamically selects the tenant database.
# ============================================================
DATABASE_URL="file:./config/databases/migration_template.db"

# Encryption Configuration
# MUST match Python backend encryption key for successful token migration
# From: backend/.env ENCRYPTION_KEY
ENCRYPTION_KEY=gvhe61ysa+PqTfD+pljdqBOmprAt9t8ELF8+JCjgN8Q=

# JWT Configuration
JWT_SECRET=a+JSNwcXnCpdmT+H1H8wLjxkpAp2LIZugUM827/TPV0=
JWT_REFRESH_SECRET=Vv7b0jiATkyOqcoNN0Qotv/gM1N4p1NHemQqDawo6Z0=

# Redis (optional for development)
REDIS_URL=redis://localhost:6379

# API Keys & Credentials (akan dimigrasikan dari backend/config/)
SHOPEE_API_KEY=
SHOPEE_API_SECRET=

LAZADA_API_KEY=
LAZADA_API_SECRET=

TIKTOK_API_KEY=
TIKTOK_API_SECRET=

# Google Integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SHEETS_ID=
GOOGLE_CONFIG_DIR=config/static/google
GOOGLE_TOKEN_DIR=config/static/google

# JWT Expiry (JWT_SECRET sudah didefinisikan di atas)
JWT_EXPIRE=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info

# Feature Flags
ENABLE_SYNC=true
ENABLE_QUEUE=true
SYNC_INTERVAL=3600
