{
  "name": "omni-backend-nodejs",
  "version": "1.0.0",
  "description": "E-commerce multi-platform backend (Node.js + Express + TypeScript)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node -r tsconfig-paths/register dist/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "tsx tests/e2e/master-runner.ts",
    "test:e2e:operation": "tsx tests/e2e/operation.test.ts",
    "test:e2e:products": "tsx tests/e2e/product-management.test.ts",
    "test:e2e:orders": "tsx tests/e2e/order-manager.test.ts",
    "test:e2e:inventory": "tsx tests/e2e/inventory.test.ts",
    "test:e2e:routes": "tsx tests/e2e/route-mapper.test.ts",
    "test:e2e:scripts": "tsx tests/e2e/script-monitor.test.ts",
    "test:e2e:analytics": "tsx tests/e2e/analytics.test.ts",
    "test:e2e:shopee": "tsx tests/e2e/shopee.test.ts",
    "test:e2e:tiktok": "tsx tests/e2e/tiktok.test.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:prod": "prisma migrate deploy",
    "prisma:migrate:all-tenants": "tsx src/scripts/migrateAllTenants.ts",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "clean": "rm -rf dist node_modules",
    "rebuild": "npm run clean && npm install && npm run build"
  },
  "keywords": [
    "ecommerce",
    "shopee",
    "lazada",
    "tiktok",
    "multi-platform"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/multer": "^2.0.0",
    "axios": "^1.13.2",
    "better-sqlite3": "12.5.0",
    "compression": "1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "4.22.1",
    "express-async-errors": "3.1.1",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "googleapis": "135.1.0",
    "helmet": "7.2.0",
    "joi": "17.13.3",
    "jsencrypt": "3.5.4",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "redis": "4.7.1",
    "superagent": "^10.2.3",
    "tsconfig-paths": "4.2.0",
    "uuid": "13.0.0",
    "winston": "3.19.0",
    "xlsx": "^0.18.5",
    "zod": "4.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "7.6.13",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "20.10.4",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "8.50.1",
    "@typescript-eslint/parser": "8.50.1",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "dependency-cruiser": "^17.3.6",
    "eslint": "^9.39.2",
    "jest": "29.7.0",
    "lighthouse": "^12.8.2",
    "prettier": "3.1.1",
    "prisma": "5.22.0",
    "puppeteer": "^24.34.0",
    "sqlite3": "^5.1.7",
    "supertest": "^7.1.4",
    "ts-jest": "29.1.1",
    "ts-node": "10.9.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
