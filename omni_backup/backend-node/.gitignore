coverage/
.nyc_output/
test-scripts/

# OS
Thumbs.db
.DS_Store

# Logs
logs/
log/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Database
*.sqlite

# ⚠️ MULTI-TENANT: Block any dev.db creation
dev.db
omni.db
prisma/*.db
prisma/dev.db

# Migration template (can be regenerated with prisma db push)
config/databases/migration_template.db

# SQLite temp files (but NOT the actual tenant databases)
*.db-shm
*.db-wal
*.db-journal

# NOTE: Actual tenant databases are in config/databases/
# Those should be excluded from git (contain user data)
config/databases/*.db
!config/databases/migration_template.db
# unless you want to exclude them from version control
prisma/*.db-shm
prisma/*.db-wal
prisma/*copy*
prisma/migrations/
data/*.db
data/*.db-shm
data/*.db-wal

# Temporary
temp/
tmp/
.cache/

# Sensitive configuration files
config/google_*.json
config/google_token.json
config/*_config.json
config/*_credentials.json
config/*_token.json
*.key
*.pem
*.p8

# Backend specific
.vscode/
.idea/
