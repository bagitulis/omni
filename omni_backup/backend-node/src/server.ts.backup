import express, { Express, Request, Response, NextFunction } from "express";
import helmet from "helmet";
import compression from "compression";
import { env } from "./config/environment";
import { corsMiddleware } from "./middleware/cors";
import { enforceHttps } from "./middleware/httpsRedirect";
import { errorHandler } from "./middleware/errorHandler";
import { backendLogger } from "./utils/backendLogger";
import healthRoutes from "./routes/health";
import tokenStatusRoutes from "./routes/tokenStatus";
import tokenOperationRoutes from "./controllers/tokenOperationController";
import orderSyncRoutes from "./controllers/orderSyncController";
import settingsRoutes from "./routes/settings";
import googleSheetsRoutes from "./routes/googleSheets";
import spreadsheetRegistryRoutes from "./routes/spreadsheetRegistry";
import inventorySheetRouter from "./routes/inventorySheet";
import inventoryColumnsRouter from "./routes/inventoryColumnsRoutes";
import inventoryDataRouter from "./routes/inventoryDataRoutes";
import inventoryConfigRouter from "./routes/inventoryConfigRoutes";
import inventorySyncRouter from "./routes/inventorySyncRoutes";
import routeMappingRoutes from "./routes/routeMapping";
import productRoutes from "./routes/products";
import skuCheckRoutes from "./routes/skuCheckRoutes";
import skuBatchCheckRoutes from "./routes/skuBatchCheckRoutes";
import filterPreferenceRoutes from "./routes/filterPreference";
import stockRoutes from "./routes/stockRoutes";
import priceRoutes from "./routes/priceRoutes";
import shopeeWalletRouter from "./routes/shopeeWalletRoutes";
import shopeeShippingRouter from "./routes/shopeeShippingRoutes";
import shopeeOperationsRouter from "./routes/shopeeOperationsRoutes";
import { walletSheetsRouter } from "./routes/walletSheetsRoutes";
import { shippingFeeSheetsRouter } from "./routes/shippingFeeSheetsRoutes";
import monitoringRoutes from "./routes/monitoringRoutes";
import { OrderSyncService } from "./services/orderSyncService";
import { TokenManager } from "./services/tokenManager";
import { initializeLogsService } from "./services/logsService";
import { initializeMonitoring } from "./systemIntegration";
import jobQueueRouter from "./routes/jobQueueRoutes";
import autoFunctionRouter from "./routes/autoFunctionRoutes";
import routeConfigRouter from "./routes/routeConfigRoutes";
import { routeExecutionConfigRouter } from "./routes/routeExecutionConfigRoutes";
import { initJobDatabase } from "./utils/jobDb";
import { getJobManager } from "./services/JobManager";
import { getJobExecutor } from "./services/JobExecutor";
import { getAutoFunctionScheduler } from "./services/AutoFunctionScheduler";
import { initializeJobHandlers } from "./services/jobHandlers";
import authRoutes from "./routes/authRoutes";
import userManagementRouter from "./routes/userManagementRoutes";
import auditRouter from "./routes/auditRoutes";
import googleServiceAccountRoutes from "./routes/googleServiceAccountRoutes";
import sheetConfigRoutes from "./routes/sheetConfigRoutes";
import wholesaleRoutes from "./routes/wholesaleRoutes";
import { tenantMiddleware } from "./middleware/tenantMiddleware";

const app: Express = express();

// Initialize services on startup
let servicesInitialized = false;
async function initializeServices() {
  if (servicesInitialized) return;
  try {
    // Initialize logs service
    initializeLogsService();

    // Initialize monitoring systems (queue, metrics, alerts)
    initializeMonitoring();

    // Initialize job database
    initJobDatabase();

    // Initialize job handlers
    initializeJobHandlers();

    // Start job executor
    const jobExecutor = getJobExecutor();
    jobExecutor.start();

    // Start auto-function scheduler
    const scheduler = getAutoFunctionScheduler();
    scheduler.start();

    const tokenManager = TokenManager.getInstance();
    await tokenManager.initialize();

    const orderSyncService = OrderSyncService.getInstance();
    await orderSyncService.initialize();

    servicesInitialized = true;
    backendLogger.success("Server", "All services initialized");
  } catch (error) {
    backendLogger.error("Server", "Service initialization failed", error);
  }
}

// Initialize on app start
initializeServices().catch((error) => {
  backendLogger.error("Server", "Service initialization failed", error);
});

// ============================================
// MIDDLEWARE SETUP
// ============================================

// HTTPS Enforcement (production only)
app.use(enforceHttps);

// Security: Helmet for HTTP headers (strengthened)
app.use(
  helmet({
    contentSecurityPolicy: {
      directives: {
        defaultSrc: ["'self'"],
        styleSrc: ["'self'", "'unsafe-inline'"], // Allow inline styles for Vue
        scriptSrc: ["'self'"],
        imgSrc: ["'self'", "data:", "https:"],
        connectSrc: ["'self'"],
        fontSrc: ["'self'"],
        objectSrc: ["'none'"],
        mediaSrc: ["'self'"],
        frameSrc: ["'none'"],
      },
    },
    hsts: {
      maxAge: 31536000, // 1 year
      includeSubDomains: true,
      preload: false, // Enable after domain verified
    },
    noSniff: true,
    referrerPolicy: { policy: "strict-origin-when-cross-origin" },
  })
);

// Compression: gzip compression for responses
app.use(
  compression({
    level: 9, // OPTIMIZED: Use maximum compression (was 6)
    threshold: 100, // OPTIMIZED: Compress anything over 100 bytes (was 500)
    filter: (req: Request, res: Response) => {
      if (req.headers["x-no-compression"]) {
        return false;
      }
      return compression.filter(req, res);
    },
  })
);

// CORS: Cross-Origin Resource Sharing
app.use(corsMiddleware);

// Body parsing
app.use(express.json({ limit: "10mb" }));
app.use(express.urlencoded({ limit: "10mb", extended: true }));

// Logging middleware
app.use((req: Request, res: Response, next: NextFunction) => {
  const startTime = Date.now();

  res.on("finish", () => {
    const duration = Date.now() - startTime;
    const status = res.statusCode;
    backendLogger.httpResponse(req.method, req.path, status, duration);
  });

  next();
});

// ============================================
// ROUTES
// ============================================

// ROOT Health check (for Docker healthcheck and direct access)
// This is placed BEFORE auth routes to avoid any middleware issues
app.get("/health", (req: Request, res: Response) => {
  res.status(200).json({
    status: "healthy",
    timestamp: new Date().toISOString(),
    uptime: process.uptime(),
    environment: process.env.NODE_ENV || "development",
    message: "✅ Backend migration server is running",
  });
});

// Auth routes (register, login, verify) - PUBLIC (no tenant context needed yet)
app.use("/api/auth", authRoutes);

// User Management routes (admin only)
app.use("/api/admin/users", userManagementRouter);

// Audit routes (view audit logs)
app.use("/api/audit", auditRouter);

// ============================================
// GLOBAL TENANT MIDDLEWARE (All routes after this require tenant context)
// ============================================
// These middleware extract tenantId from JWT token
// authMiddleware attaches req.tenantId from token
// Controllers pass tenantId to services for multi-tenant support

app.use(tenantMiddleware);

// Health check routes
app.use("/api", healthRoutes);
// Token status routes
app.use("/api", tokenStatusRoutes);
// Token operation routes (refresh, etc)
app.use("/api", tokenOperationRoutes);
// Order sync routes
app.use("/api/orders", orderSyncRoutes);
// Settings routes (debug logs, resources)
app.use("/api/settings", settingsRoutes);
// Google Sheets routes (auth, spreadsheet operations)
app.use("/api/google", googleSheetsRoutes);
// Google Service Account routes (management, switching, detection)
app.use("/api/google/service-accounts", googleServiceAccountRoutes);
// Spreadsheet Registry routes (URL registration, listing, locking)
app.use("/api/google/registry", spreadsheetRegistryRoutes);
// Sheet configuration routes (save/load registered sheets)
app.use("/api/google/sheet-config", sheetConfigRoutes);
// Inventory columns routes (most specific - register first)
app.use("/api/inventory/columns", inventoryColumnsRouter);
// Inventory config routes (settings, stats) - before generic /api/inventory
app.use("/api/inventory/config", inventoryConfigRouter);
// Inventory sync routes - before generic /api/inventory
app.use("/api/inventory/sync", inventorySyncRouter);
// Inventory sheet export/import routes - before generic /api/inventory
app.use("/api/inventory", inventorySheetRouter);
// Inventory batch check SKU routes - before generic /api/inventory
app.use("/api", skuBatchCheckRoutes);
// Inventory data routes (CRUD) - generic catch-all, register last
app.use("/api/inventory", inventoryDataRouter);
// Stock update routes (update stock to platforms)
app.use("/api/inventory", stockRoutes);
// Price update routes (update price to platforms)
app.use("/api/inventory", priceRoutes);
// Wholesale routes (wholesale tiers management)
app.use("/api/wholesale", wholesaleRoutes);
// Route Mapping routes
app.use("/api/route-mapping", routeMappingRoutes);
// SKU Check routes (must be BEFORE product routes to avoid param collision)
app.use("/api", skuCheckRoutes);
// Product routes (Lazada, TikTok)
app.use("/api", productRoutes);
// Filter preference routes
app.use("/api/filter-preferences", filterPreferenceRoutes);
// Shopee wallet routes
app.use("/api/shopee/operations/wallet", shopeeWalletRouter);
// Shopee shipping fee routes
app.use("/api/shopee/operations/shipping", shopeeShippingRouter);
// Shopee operations routes (combined operations)
app.use("/api/shopee/operations", shopeeOperationsRouter);
// Wallet sheets export routes (legacy + operations alias)
[
  "/api/sheets/wallet-to-sheets",
  "/api/sheets/operations/wallet-to-sheets",
].forEach((path) => app.use(path, walletSheetsRouter));
// Shipping fee sheets export routes (legacy + operations alias)
[
  "/api/sheets/shipping-fee-to-sheets",
  "/api/sheets/operations/shipping-fee-to-sheets",
].forEach((path) => app.use(path, shippingFeeSheetsRouter));
// Job queue routes (monitoring, queue, history)
app.use("/api/jobs", jobQueueRouter);
// Auto-function routes (scheduling, configuration)
app.use("/api/jobs/auto-functions", autoFunctionRouter);
// Route config routes (dynamic route, caching, queue management)
app.use("/api/routes-config", routeConfigRouter);
// Route execution config routes (manual trigger mode: queue vs direct)
app.use("/api/route-execution-config", routeExecutionConfigRouter);
// Monitoring routes (metrics, alerts, performance) - tenant-aware
app.use("/api/monitoring", monitoringRoutes);

// Root API endpoint
app.get("/api", (req: Request, res: Response) => {
  res.json({
    name: "Omni Backend Migration API",
    version: "1.0.0",
    description: "Backend migration from Python Flask to Node.js Express",
    endpoints: {
      health: "/api/health",
      status: "/api/status",
      "token-status": "/api/token-status",
      "refresh-token": "POST /api/:platform/operations/refresh-token",
      settings: {
        "debug-logs": "GET /api/settings/debug-logs",
        "clear-logs": "POST /api/settings/debug-logs/clear",
        "resource-usage": "GET /api/settings/resource-usage",
      },
      google: {
        "auth-status": "GET /api/google/auth/status",
        "auth-initiate": "GET /api/google/auth/initiate",
        "auth-callback": "GET /api/google/auth/callback",
        "auth-logout": "GET /api/google/auth/logout",
        "sheets-list": "GET /api/google/sheets/list",
        "worksheet-list": "GET /api/google/worksheets/:spreadsheetId",
        "create-spreadsheet": "POST /api/google/spreadsheets/create",
        "update-settings": "POST /api/google/settings/update-detailed",
        "test-connection": "GET /api/google/settings/test",
        "refresh-sheets": "GET /api/google/sheets/refresh",
      },
      orders: {
        "sync-category": "GET /api/orders/sync-category?category=unpaid&days=7",
        "all-by-category": "GET /api/orders/all/:category",
        "platform-orders": "GET /api/orders/:platform/:category",
        "sync-platform": "POST /api/orders/:platform/sync-category",
        "order-details": "POST /api/orders/:platform/details",
      },
    },
  });
});

// 404 handler
app.use((req: Request, res: Response) => {
  res.status(404).json({
    success: false,
    error: {
      message: "Route not found",
      code: "NOT_FOUND",
      statusCode: 404,
      path: req.path,
      method: req.method,
    },
  });
});

// ============================================
// ERROR HANDLER (Must be last middleware)
// ============================================

app.use(errorHandler);

// ============================================
// SERVER STARTUP
// ============================================

const PORT = env.PORT;

const server = app.listen(PORT, "0.0.0.0", () => {
  backendLogger.success("Server", "=".repeat(60));
  backendLogger.success("Server", "🚀 BACKEND MIGRATION SERVER STARTED");
  backendLogger.success("Server", "=".repeat(60));
  backendLogger.info("Server", `Server running on port ${PORT}`);
  backendLogger.info("Server", `Local: http://localhost:${PORT}`);
  backendLogger.info("Server", `Network: http://0.0.0.0:${PORT}`);
  backendLogger.info("Server", `Environment: ${env.NODE_ENV}`);
  backendLogger.info("Server", `CORS Origins: ${env.CORS_ORIGINS.join(", ")}`);
  backendLogger.success("Server", "=".repeat(60));
});

// Graceful shutdown
process.on("SIGTERM", () => {
  backendLogger.warning("Server", "SIGTERM received, shutting down gracefully");
  server.close(() => {
    backendLogger.info("Server", "Server closed");
    process.exit(0);
  });
});

process.on("SIGINT", () => {
  backendLogger.warning("Server", "SIGINT received, shutting down gracefully");
  server.close(() => {
    backendLogger.info("Server", "Server closed");
    process.exit(0);
  });
});

export default app;
