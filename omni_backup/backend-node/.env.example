# ====================
# Server Configuration
# ====================
NODE_ENV=development
PORT=3001
API_PREFIX=/api

# ====================
# CORS Configuration
# ====================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5000
CORS_ORIGIN=http://localhost:5173

# ====================
# Database Configuration
# ====================
# ⚠️ MULTI-TENANT ARCHITECTURE ⚠️
# This project uses SEPARATE databases per tenant!
# DO NOT use dev.db - each tenant has their own database.
#
# Database location: backend/config/databases/
#   - {tenant}_bertigamart.db (main tenant data)
#   - {tenant}_jobs.db (jobs & auto-functions)
#
# Tenant config: backend/config/static/tenants.json
# Runtime selection: src/services/tenantManagementService.ts
#
# DATABASE_URL is ONLY for Prisma CLI (migrate/generate).
DATABASE_URL=file:./config/databases/migration_template.db

# ====================
# Encryption Configuration
# ====================
# MUST match Python backend encryption key for successful token migration
ENCRYPTION_KEY=DrGDMbHdRlgnSqDfmTkHbMVNLUpoNYbCeDPiCTHxqZU=

# ====================
# Redis Configuration (optional for development)
# ====================
REDIS_URL=redis://localhost:6379

# ====================
# API Keys & Credentials
# ====================
SHOPEE_API_KEY=
SHOPEE_API_SECRET=

LAZADA_API_KEY=
LAZADA_API_SECRET=

TIKTOK_API_KEY=
TIKTOK_API_SECRET=

# ====================
# Google Integration
# ====================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SHEETS_ID=

# Google Sheets Configuration Paths
# Use relative paths (from project root) or absolute paths
# Examples:
#   Relative: GOOGLE_CONFIG_DIR=config
#   Relative: GOOGLE_CONFIG_DIR=../backend/config
#   Absolute: GOOGLE_CONFIG_DIR=/home/user/project/config
#   Absolute: GOOGLE_CONFIG_DIR=C:\Users\user\project\config
GOOGLE_CONFIG_DIR=config
GOOGLE_TOKEN_DIR=config

# ====================
# JWT Configuration
# ====================
JWT_SECRET=omni-ecommerce-migration-secret-key-2025
JWT_EXPIRE=7d

# ====================
# Logging Configuration
# ====================
LOG_LEVEL=info

# ====================
# Feature Flags
# ====================
ENABLE_SYNC=true
ENABLE_QUEUE=true
SYNC_INTERVAL=3600
